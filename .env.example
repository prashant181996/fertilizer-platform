# Local development only. Copy to .env and change before shared environments.
DB_USER=fertilizer
DB_PASSWORD=change-me

# Local Compose Kafka settings (single broker, so replication factor must remain 1).
KAFKA_TOPIC_PARTITIONS=48
KAFKA_TOPIC_REPLICATION_FACTOR=1
ORDER_KAFKA_CONCURRENCY=12
INVENTORY_SERVICE_KAFKA_CONCURRENCY=12
PAYMENT_SERVICE_KAFKA_CONCURRENCY=12
DELIVERY_SERVICE_KAFKA_CONCURRENCY=6
NOTIFICATION_SERVICE_KAFKA_CONCURRENCY=6
RATE_LIMIT_REPLENISH=1000
RATE_LIMIT_BURST=2000
